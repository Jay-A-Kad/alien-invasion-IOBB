mono_crash.*
crashlytics-buildid.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Plastic SCM / Collab
/[Aa]ssets/Plugins/Editor/JetBrains*
.collabignore
.plastic/

# Gradle cache
.gradle/

# OS files
.DS_Store
**/.DS_Store
Thumbs.db
Desktop.ini

